# ─── Database ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Docker local: postgresql://digiboost:digiboost_pass@localhost:5432/digiboostbd?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Payment Gateways (future phases) ───────────────────────────────────────
BKASH_API_KEY=
NAGAD_API_KEY=

# ─── Admin Setup ────────────────────────────────────────────────────────────
# Used by prisma/seed.ts to create the initial admin account
ADMIN_EMAIL="jannatisha123@gmail.com"
ADMIN_PASSWORD="EshaEsha#123"