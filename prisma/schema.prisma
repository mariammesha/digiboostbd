// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  client Client?
}

model Client {
  id           String      @id @default(cuid())
  userId       String      @unique
  businessName String
  phone        String
  packageTier  PackageTier @default(BASIC)
  createdAt    DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  reports  Report[]
}

model Package {
  id            String  @id @default(cuid())
  name          String
  monthlyFeeBDT Float
  description   String
}

model Invoice {
  id          String   @id @default(cuid())
  clientId    String
  amountBDT   Float
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  fileUrl     String
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id             String   @id @default("singleton")
  whatsappNumber String   @default("8801700000000")
  contactEmail   String   @default("hello@digiboostbd.com")
  contactAddress String   @default("Dhaka, Bangladesh")
  accentColor    String   @default("orange")
  updatedAt      DateTime @updatedAt
}
