// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum AuditStatus {
  NEW
  CONTACTED
  CONVERTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  client Client?
}

model Client {
  id           String      @id @default(cuid())
  userId       String      @unique
  businessName String
  phone        String
  packageTier  PackageTier @default(BASIC)
  createdAt    DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  reports  Report[]
}

model Package {
  id            String  @id @default(cuid())
  name          String
  monthlyFeeBDT Float
  description   String
}

model Invoice {
  id          String   @id @default(cuid())
  clientId    String
  amountBDT   Float
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  fileUrl     String
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id             String   @id @default("singleton")
  whatsappNumber String   @default("8801752993428")
  contactEmail   String   @default("dgboostbd@gmail.com")
  contactAddress String   @default("Sylhet, Bangladesh")
  facebookUrl    String   @default("https://www.facebook.com/share/1Dd569DHdW/")
  instagramUrl   String   @default("https://www.instagram.com/dgboost.bd?igsh=a3U4Ynk5NG1yNzlr")
  accentColor    String   @default("orange")
  updatedAt      DateTime @updatedAt
}

model AuditRequest {
  id                 String      @id @default(cuid())
  businessName       String
  ownerName          String
  phone              String
  businessType       String
  websiteOrPage      String?
  marketingChallenge String
  status             AuditStatus @default(NEW)
  createdAt          DateTime    @default(now())
}
